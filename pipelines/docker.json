{
  "description": "Pipeline for processing docker logs",
  "processors": [
    {
      "dot_expander": {
        "field": "docker.container.labels.com.docker.stack.namespace"
      },
      "pipeline": {
        "if": "ctx.docker.container.labels.com.docker.stack.namespace == 'elk-stack'",
        "name": "elk-stack"
      },
      "append": {
        "field": "tags",
        "value": ["{{docker.container.labels.com.docker.stack.namespace}}", "{{docker.container.labels.com.docker.swarm.service.name}}"]
      }
    }
  ],
  "on_failure": [
    {
      "set": {
        "field": "pipeline.docker.error",
        "value": "{{ _ingest.on_failure_processor_type }}: {{ _ingest.on_failure_message }}"
      }
    }
  ]
}