{
  "description": "Pipeline for processing docker logs",
  "processors": [
    {
      "foreach": {
        "field": "tags",
        "processor": {
          "append": {
            "field": "originalTags",
            "value": "{{_ingest._value}}"
          }
        }
      }
    },
    {
      "remove": {
        "field": "tags"
      }
    },
    {
      "dot_expander": {
        "field": "container.labels.com_docker_swarm_service_name"
      }
    },
    {
      "pipeline": {
        "if": "ctx.container.labels.com_docker_swarm_service_name == 'elk-stack_kibana'",
        "name": "elk-stack_kibana"
      }
    },
    {
      "pipeline": {
        "if": "ctx.container.labels.com_docker_swarm_service_name == 'elk-stack_elasticsearch'",
        "name": "elk-stack_elasticsearch"
      }
    },
    {
      "foreach": {
        "field": "originalTags",
        "processor": {
          "append": {
            "field": "tags",
            "value": "{{_ingest._value}}"
          }
        }
      }
    },
    {
      "append": {
        "field": "tags",
        "value": ["{{container.labels.com_docker_stack_namespace}}", "{{container.labels.com_docker_swarm_service_name}}"]
      }
    }
  ],
  "on_failure": [
    {
      "set": {
        "field": "pipeline.docker.error",
        "value": "{{ _ingest.on_failure_processor_type }}: {{ _ingest.on_failure_message }}"
      }
    }
  ]
}