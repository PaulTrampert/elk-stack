{
  "description": "Pipeline for processing docker logs",
  "processors": [
    {
      "foreach": {
        "field": "tags",
        "processor": {
          "append": {
            "field": "originalTags",
            "value": "{{_ingest._value}}"
          }
        }
      }
    },
    {
      "remove": {
        "field": "tags"
      }
    },
    {
      "dot_expander": {
        "field": "docker.container.labels.com.docker.swarm.service.name"
      }
    },
    {
      "pipeline": {
        "if": "ctx.docker.container.labels.com.docker.swarm.service.name == 'elk-stack_kibana'",
        "name": "elk-stack_kibana"
      }
    },
    {
      "foreach": {
        "field": "originalTags",
        "processor": {
          "append": {
            "field": "tags",
            "value": "{{_ingest._value}}"
          }
        }
      }
    },
    {
      "append": {
        "field": "tags",
        "value": ["{{docker.container.labels.com.docker.stack.namespace}}", "{{docker.container.labels.com.docker.swarm.service.name}}"]
      }
    }
  ],
  "on_failure": [
    {
      "set": {
        "field": "pipeline.docker.error",
        "value": "{{ _ingest.on_failure_processor_type }}: {{ _ingest.on_failure_message }}"
      }
    }
  ]
}